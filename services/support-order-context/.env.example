# WooCommerce (bushpop.com.au) — use a dedicated READ-ONLY REST API key,
# not the existing read_write "Claude AI" key used by the n8n ETL workflow.
# Mint at: bushpop.com.au/wp-admin -> WooCommerce -> Settings -> Advanced -> REST API
WC_BASE_URL=https://bushpop.com.au
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Shared secret checked on every /api/orders request (query param `token`).
# Generate with: openssl rand -hex 32
# Configure the same value as a static query param on the Chatwoot Dashboard
# App URL: https://support.bushpop.xyz/order-context/?token=<value>
ORDER_CONTEXT_TOKEN=

# Port the service listens on inside the container (matches docker-compose.yml).
PORT=3000
