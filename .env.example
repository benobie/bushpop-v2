# Database
DATABASE_URL=postgres://bushpop:bushpop_dev@localhost:5435/bushpop
BUSHPOP_DB_PASSWORD=bushpop_dev

# Redis
REDIS_URL=redis://localhost:6380

# MeiliSearch
MEILI_MASTER_KEY=dev_master_key_change_in_production
MEILISEARCH_HOST=http://localhost:7701

# Auth (Better Auth)
BETTER_AUTH_SECRET=dev_secret_change_in_production_must_be_32_chars

# URLs
WEB_URL=http://localhost:3002
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:3333

# Email (Resend — optional for dev)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=hello@bushpop.com.au

# Error tracking (optional for dev)
# SENTRY_DSN=

# Cloudflare R2 (image storage)
# R2_PUBLIC_URL must be NON-EMPTY or the API throws on any image URL it builds
# (browse / search / PDP) — see packages/api/src/lib/image-url.ts (issue #29).
# The default below lets the storefront render locally; seeded images 404 but
# do not throw. Upload creds (account/access/secret) stay blank for dev.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bushpop-media
R2_PUBLIC_URL=https://media.bushpop.com.au

# AI Enrichment (Claude Haiku vision — optional, enrichment worker disabled without it)
ANTHROPIC_API_KEY=

# Payments (Stripe)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
# Public Stripe publishable key — loaded client-side by Stripe.js (Lane A buyer storefront).
# NOTE: Next inlines NEXT_PUBLIC_* at BUILD time — in prod this is a Docker build ARG
# (compose web.build.args), not a runtime env var. Empty → loadStripe("") → dead checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Shipping (StarShipIt)
STARSHIPIT_API_KEY=your_starshipit_api_key_here
STARSHIPIT_WEBHOOK_SECRET=your_starshipit_webhook_secret_here
# Ocp-Apim-Subscription-Key for OUTBOUND Starshipit REST calls (NOT webhook auth).
# Optional, but outbound label/tracking calls 403 if the account's gateway enforces it.
# STARSHIPIT_SUBSCRIPTION_KEY=

# Operator-alert destination (optional — defaults to admin@bushpop.com.au)
# ADMIN_EMAIL=ops@bushpop.com.au

# Feature flags
# Moderation queue v1 (B4) — ships dark. Gates the admin manual-flag-listing
# intake route (packages/api/src/routes/v1/admin/moderation.ts) AND the
# apps/market /admin/moderation page. The existing GET/PATCH
# /api/v1/admin/reports routes predate this flag and stay always-on.
# Multi-vendor onboarding (track F) is hard-gated on this queue being live.
# MODERATION_QUEUE_ENABLED=true

# Channel
CHANNEL_SLUG=bushpop

# Node environment
NODE_ENV=development
